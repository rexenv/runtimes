diff --git a/src/util/tmpdir.cpp b/src/util/tmpdir.cpp
new file mode 100644
index 0000000..271556f
--- /dev/null
+++ b/src/util/tmpdir.cpp
@@ -0,0 +1,70 @@
+/*
+ * Runtime override of the server's tmp directory — see src/config.h.cmake.
+ * Not upstream; carried by rexenv/runtimes (patches/openlitespeed/0003).
+ */
+#include <config.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char s_tmpDir[512];
+static int  s_overridden = 0;
+static pthread_once_t s_once = PTHREAD_ONCE_INIT;
+
+static void initTmpDir(void)
+{
+    const char *p = getenv("LSWS_TMP_DIR");
+    if (p && *p == '/' && strlen(p) < sizeof(s_tmpDir))
+        s_overridden = 1;
+    else
+        p = LS_BUILTIN_TMP_DIR;
+    memcpy(s_tmpDir, p, strlen(p) + 1);
+    size_t n = strlen(s_tmpDir);
+    while (n > 1 && s_tmpDir[n - 1] == '/')
+        s_tmpDir[--n] = 0;
+}
+
+extern "C" const char *ls_tmp_dir(void)
+{
+    pthread_once(&s_once, initTmpDir);
+    return s_tmpDir;
+}
+
+extern "C" int ls_tmp_dir_overridden(void)
+{
+    pthread_once(&s_once, initTmpDir);
+    return s_overridden;
+}
+
+/* A handful of fixed names, each built once and never freed: the callers keep
+ * the pointer (a member initialiser, a #define used in several places). */
+extern "C" const char *ls_tmp_file(const char *name)
+{
+    static struct { const char *name; char *path; } s_cache[16];
+    static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+    const char *ret = NULL;
+    pthread_mutex_lock(&s_lock);
+    for (size_t i = 0; i < sizeof(s_cache) / sizeof(s_cache[0]); ++i)
+    {
+        if (s_cache[i].name == NULL)
+        {
+            size_t len = strlen(ls_tmp_dir()) + 1 + strlen(name) + 1;
+            char *p = (char *)malloc(len);
+            if (p == NULL)
+                break;
+            snprintf(p, len, "%s/%s", ls_tmp_dir(), name);
+            s_cache[i].name = strdup(name);
+            s_cache[i].path = p;
+            ret = p;
+            break;
+        }
+        if (strcmp(s_cache[i].name, name) == 0)
+        {
+            ret = s_cache[i].path;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&s_lock);
+    return ret ? ret : LS_BUILTIN_TMP_DIR;
+}
